#!/bin/sh
# Tells surface-manager the geometry/format virtio-gpu accepts (without it page flips fail and the
# screen stays on the text console). Runs on every boot, before the compositor starts, because configd
# does not keep the setting across reboots. Size = the virtual display's preferred mode.
# wait for the virtual display (virtio_gpu)
j=0; while [ $j -lt 30 ] && ! ls /sys/class/drm/card0-*/modes >/dev/null 2>&1; do j=$((j + 1)); sleep 1; done
C=$(ls -d /sys/class/drm/card0-*/ 2>/dev/null | head -n 1)
M=$(head -n 1 "${C}modes" 2>/dev/null)
case "$M" in [0-9]*x[0-9]*) ;; *) M=1920x1080 ;; esac
OUT=$(basename "${C:-card0-Virtual-1}" | sed 's/^card0-//; s/-//g')
GEOM="${M}+0+0r0s1"
BODY='{"configs":{"com.webos.surfacemanager.compositorGeometry":"'$GEOM'","com.webos.surfacemanager.displayConfig":[{"device":"/dev/dri/card0","hwcursor":false,"outputs":[{"name":"'$OUT'","geometry":"'$GEOM'","mode":"'$M'","format":"xrgb8888"}]}]}}'
i=0
while [ $i -lt 60 ]; do
    luna-send -n 1 -a com.webos.surfacemanager luna://com.webos.service.config/setConfigs "$BODY" 2>&1 | grep -q '"returnValue":true' && exit 0
    i=$((i + 1)); sleep 2
done
logger -t webos-kvm "setConfigs failed"
exit 1
